# ==============================================================================
# SERRUCHO MVP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL (for public settlement links and email redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# In local dev / demo mode without Supabase, Serrucho runs using its built-in memory store.
# To connect to a live Supabase project, populate these variables:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# Email Notifications (Resend)
# ------------------------------------------------------------------------------
# Required for sending automated transactional emails upon closing a Serrucho.
# If unset, Serrucho will simulate email delivery and log to console/history.
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Serrucho <notificaciones@serrucho.do>"

# ------------------------------------------------------------------------------
# WhatsApp Cloud API Notifications (Meta - Optional)
# ------------------------------------------------------------------------------
# Optional adapter for sending WhatsApp template messages.
# If unset, the system automatically falls back to Email notifications.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="serrucho_settlement_notification"
