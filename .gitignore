# ==========================================
# SERRUCHO MONOREPO — .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Environment files (CRITICAL: Never commit secrets)
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local

# Turborepo & Build Caches
.turbo/
**/.turbo/

# Next.js Build Outputs
.next/
**/.next/
out/
**/out/

# Expo & React Native Build Outputs
.expo/
**/.expo/
android/
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Distribution & Compiled Code
dist/
**/dist/
build/
**/build/

# Testing & Coverage
coverage/
**/coverage/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/
playwright/.cache/

# TypeScript Build Info
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
apps/web/next-env.d.ts

# Vercel deployment metadata
.vercel/
**/.vercel/

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS & Editor generated files
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
