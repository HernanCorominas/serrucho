{
  "name": "serrucho-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@serrucho/web",
    "dev:mobile": "npm run start --workspace=@serrucho/mobile",
    "dev:mobile-web": "npm run web --workspace=@serrucho/mobile",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=@serrucho/web",
    "start": "npm run start --workspace=@serrucho/web",
    "lint": "npm run lint --workspace=@serrucho/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@serrucho/core",
    "test": "npm run test --workspace=@serrucho/web",
    "test:watch": "npm run test:watch --workspace=@serrucho/web",
    "test:e2e": "npm run test:e2e --workspace=@serrucho/web",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/metro-cache/package.json';if(fs.existsSync(p)){const j=JSON.parse(fs.readFileSync(p));if(j.exports&&!j.exports['./*']){j.exports['./*']='./*';j.exports['./src/*']='./src/*';fs.writeFileSync(p,JSON.stringify(j,null,2));}}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.474.0",
    "next": "15.1.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "resend": "^4.1.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
